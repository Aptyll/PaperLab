{
  "name": "memecoin-paper-lab",
  "version": "0.1.0",
  "description": "Local paper-trading research dashboard for Solana memecoins. No wallets, no real trades.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
    "demo": "node --disable-warning=ExperimentalWarning src/main.js --demo",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "check": "tsc -p tsconfig.json"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
